#!/usr/bin/env ys-0

# Generate cc-logo-data.js from src/dialects.yaml.

defn main():
  data =: load('../src/dialects.yaml')
  json =:
    data
      .filter(\(_.fext))
      .map(entry)
      .join(',')
  json =: "[$json]"
  say: "window.CC_LOGO_DIALECTS = $json;"

defn entry(d):
  fext =: json-string(d.fext)
  name =: json-string(d.name)
  site =: json-string(d.site ||| d.repo)
  =>: "{\"fext\":$fext,\"name\":$name,\"site\":$site}"

defn json-string(value):
  value =: value.replace('\\' '\\\\').replace('"' '\\"')
  =>: "\"$value\""
