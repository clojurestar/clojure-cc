#!/usr/bin/env ys-0

# Generate cc-logo-data.js from src/dialects.yaml.

defn main():
  data =: read('src/dialects.yaml'):yaml/load
  json =:
    json/dump: data
      .mapcat(\(_.list))
      .filter(\(_.ext))
      .map(entry)
  say: "window.CC_LOGO_DIALECTS = $json;"

defn entry(d)::
  ext  :: d.ext
  name :: d.name
  site :: d.site
