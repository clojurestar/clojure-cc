#!/usr/bin/env ys-0

# Fetch star counts and latest release info for every dialect with a
# `repo:` URL in src/dialects.yaml, then write the result to
# repo-data.yaml keyed by repo URL.
#
# Supports GitHub and GitLab. Repos without releases fall back to the
# latest commit on the default branch (stored under `commit:`).
# Failures (network, rate limit, missing repo) skip the entry silently.

i =: atom(0)

defn main():
  out =: 'repo-data.yaml'
  dialects =: read('src/dialects.yaml'):yaml/load
  entries =: dialects.filter(\(_.repo))
  data =: entries.reduce(collect {})
  # data =: entries.drop(entries.# - 3):butlast.reduce(collect {})
  write out: yaml/dump(data)
  say: "Refreshed $(data.#) of $(entries.#) entries."

defn collect(acc entry):
  swap! i: inc
  warn: "$(i.@)) $(entry.name)"
  info =: fetch-info(entry.repo)
  if info:
    assoc acc: entry.repo info
    else: acc

defn fetch-info(url):
  cond:
    url =~ /github\.com\//: github-info(url)
    url =~ /gitlab\.com\//: gitlab-info(url)

defn github-info(url):
  m =: url =~ /github\.com\/([^\/?#]+)\/([^\/?#]+)/
  owner repo =: m:rest
  star =: github-stars(owner repo)
  when star:
    release =: github-release(owner repo)
    commit =:
      when-not release:
        github-commit(owner repo)
    build-info: star release commit

defn github-headers():
  base =::
    Accept: application/vnd.github+json
  if ENV.GITHUB_TOKEN:
    then: base.assoc("Authorization" "Bearer $(ENV.GITHUB_TOKEN)")
    else: base

defn github-get(api):
  http/get api::
    :headers:: github-headers()

defn github-stars(owner repo):
  api =: "https://api.github.com/repos/$owner/$repo"
  try:
    get _ 'stargazers_count':
      github-get(api).body:json/load
    catch Exception e:

defn github-release(owner repo):
  api =: "https://api.github.com/repos/$owner/$repo/releases/latest"
  data =:
    try:
      json/load: github-get(api).body
      catch Exception e:
  when data:
    d =: data.published_at.subs(0 10)
    v =: data.tag_name
    u =: data.html_url
    =>: +{:date d, :version v, :url u}

defn github-commit(owner repo):
  api =: "https://api.github.com/repos/$owner/$repo/commits?per_page=1"
  data =:
    try:
      json/load: github-get(api).body
      catch Exception e:
  when data.#.?:
    c =: data:first
    d =: c.commit.committer.date.subs(0 10)
    s =: c.sha.subs(0 7)
    u =: c.html_url
    =>: +{:date d, :sha s, :url u}

defn gitlab-info(url):
  m =: re-find(/gitlab\.com\/([^\/?#]+)\/([^\/?#]+)/ url)
  proj =: "$(m.1)%2F$(m.2)"
  star =: gitlab-stars(proj)
  when star:
    release =: gitlab-release(proj)
    commit =:
      when-not release:
        gitlab-commit(proj)
    build-info: star release commit

defn gitlab-stars(proj):
  api =: "https://gitlab.com/api/v4/projects/$proj"
  try:
    get _ 'star_count': http/get(api).body:json/load
    catch Exception e:

defn gitlab-release(proj):
  api =: "https://gitlab.com/api/v4/projects/$proj/releases"
  releases =:
    try:
      json/load: http/get(api).body
      catch Exception e:
  when releases.#.?:
    rel =: releases:first
    d =: rel.released_at.subs(0 10)
    v =: rel.tag_name
    u =: rel.'_links'.self
    =>: +{:date d, :version v, :url u}

defn gitlab-commit(proj):
  api =: "https://gitlab.com/api/v4/projects/$proj/repository/commits?per_page=1"
  commits =:
    try:
      json/load: http/get(api).body
      catch Exception e:
  when commits.#.?:
    c =: commits:first
    d =: c.committed_date.subs(0 10)
    s =: c.short_id
    u =: c.web_url
    =>: +{:date d, :sha s, :url u}

defn build-info(star release commit):
  base =: +{:star star}
  cond:
    release: base.assoc(:release release)
    commit:  base.assoc(:commit commit)
    else:    base
