#!/usr/bin/env ys-0

# Fetch star counts and latest release info for every dialect with a
# `repo:` URL in src/dialects.yaml, then write the result to
# repo-data.yaml keyed by repo URL. An optional `ghub:` URL supplies
# the star count while `repo:` remains the canonical metadata source.
#
# Supports GitHub, GitLab, and sourcehut. GitHub/GitLab repos without
# releases fall back to the latest commit on the default branch (stored
# under `commit:`). Sourcehut entries carry only `release:` unless a
# GitHub mirror is specified with `ghub:`.
# GitHub requests use $GITHUB_TOKEN when set, otherwise they read
# ~/.release-secrets.yaml at .github.token.

i =: atom(0)

defn main():
  out =: 'repo-data.yaml'
  dialects =: read('src/dialects.yaml'):yaml/load
  entries =: dialects.filter(\(_.repo))
  when-not github-token():
    die: 'No GitHub token found; unauthenticated rate limit applies.'
  data =: entries.reduce(collect {})
  # data =: entries.drop(entries.# - 3):butlast.reduce(collect {})
  when data.# != entries.#:
    die: "Refreshed only $(data.#) of $(entries.#) entries."
  write out: yaml/dump(data)
  say: "Refreshed $(data.#) of $(entries.#) entries."

defn collect(acc entry):
  swap! i: inc
  warn: "$(i.@)) $(entry.name)"
  info =: fetch-info(entry)
  if info:
    assoc acc: entry.repo info
    else: acc

defn fetch-info(entry):
  url =: entry.repo
  info =:
    cond:
      url =~ /github\.com\//: github-info(url)
      url =~ /gitlab\.com\//: gitlab-info(url)
      url =~ /sr\.ht\//:      sourcehut-info(url)
  add-ghub-star: info entry.ghub

defn add-ghub-star(info url):
  empty =: +{}
  base =: info ||| empty
  star =:
    when url:
      github-star: url
  if star:
    then: base.assoc(:star star)
    else: info

defn github-star(url):
  m =: url =~ /github\.com\/([^\/?#]+)\/([^\/?#]+)/
  owner repo =: m:rest
  github-stars: owner repo

defn github-info(url):
  m =: url =~ /github\.com\/([^\/?#]+)\/([^\/?#]+)/
  owner repo =: m:rest
  star =: github-stars(owner repo)
  when star:
    release =: github-release(owner repo)
    commit =:
      when-not release:
        github-commit(owner repo)
    build-info: star release commit

defn github-headers():
  base =::
    Accept: application/vnd.github+json
  token =: github-token()
  if token:
    then: base.assoc("Authorization" github-auth(token))
    else: base

defn github-auth(token):
  token =: token:S:trim
  if token =~ /^(Bearer|token) /:
    token
    "token $token"

defn github-token():
  ENV.GITHUB_TOKEN ||| release-secret-github-token()

defn release-secret-github-token():
  when ENV.HOME:
    path =: "$(ENV.HOME)/.release-secrets.yaml"
    when path:fs-e:
      secrets =: read(path):yaml/load
      secrets.github.token |||: secrets.'.github'.token

defn github-get(api):
  http/get api::
    :headers:: github-headers()

defn github-stars(owner repo):
  api =: "https://api.github.com/repos/$owner/$repo"
  try:
    get _ 'stargazers_count':
      github-get(api).body:json/load
    catch Exception e:
      warn: "GitHub fetch failed for $owner/$repo."

defn github-release(owner repo):
  api =: "https://api.github.com/repos/$owner/$repo/releases/latest"
  data =:
    try:
      json/load: github-get(api).body
      catch Exception e:
  when data:
    d =: data.published_at.subs(0 10)
    v =: data.tag_name
    u =: data.html_url
    =>: +{:date d, :version v, :url u}

defn github-commit(owner repo):
  api =: "https://api.github.com/repos/$owner/$repo/commits?per_page=1"
  data =:
    try:
      json/load: github-get(api).body
      catch Exception e:
  when data.#.?:
    c =: data:first
    d =: c.commit.committer.date.subs(0 10)
    s =: c.sha.subs(0 7)
    u =: c.html_url
    =>: +{:date d, :sha s, :url u}

defn gitlab-info(url):
  m =: re-find(/gitlab\.com\/([^\/?#]+)\/([^\/?#]+)/ url)
  proj =: "$(m.1)%2F$(m.2)"
  star =: gitlab-stars(proj)
  when star:
    release =: gitlab-release(proj)
    commit =:
      when-not release:
        gitlab-commit(proj)
    build-info: star release commit

defn gitlab-stars(proj):
  api =: "https://gitlab.com/api/v4/projects/$proj"
  try:
    get _ 'star_count': http/get(api).body:json/load
    catch Exception e:

defn gitlab-release(proj):
  api =: "https://gitlab.com/api/v4/projects/$proj/releases"
  releases =:
    try:
      json/load: http/get(api).body
      catch Exception e:
  when releases.#.?:
    rel =: releases:first
    d =: rel.released_at.subs(0 10)
    v =: rel.tag_name
    u =: rel.'_links'.self
    =>: +{:date d, :version v, :url u}

defn gitlab-commit(proj):
  api =: "https://gitlab.com/api/v4/projects/$proj/repository/commits\
          ?per_page=1"
  commits =:
    try:
      json/load: http/get(api).body
      catch Exception e:
  when commits.#.?:
    c =: commits:first
    d =: c.committed_date.subs(0 10)
    s =: c.short_id
    u =: c.web_url
    =>: +{:date d, :sha s, :url u}

defn sourcehut-info(url):
  m =: url =~ /sr\.ht\/(~[^\/?#]+)\/([^\/?#]+)/
  user proj =: m:rest
  api =: "https://git.sr.ht/$user/$proj/refs/rss.xml"
  xml =:
    try:
      http/get(api): .body
      catch Exception e:
  when xml:
    release =: sourcehut-release(xml)
    when release:
      =>: +{:release release}

defn sourcehut-release(xml):
  item =: (xml =~ /<item>([\s\S]*?)<\/item>/):rest:first
  when item:
    l =: (item =~ /<link>([^<]+)<\/link>/):rest:first
    d =: (item =~ /<pubDate>([^<]+)<\/pubDate>/):rest:first
    v =: (l =~ /\/refs\/(.+)$/):rest:first
    when l && d && v:
      M+: :date rfc822-date(d), :version v, :url l

defn rfc822-date(s):
  months =:
    +{'Jan' '01', 'Feb' '02', 'Mar' '03', 'Apr' '04',
      'May' '05', 'Jun' '06', 'Jul' '07', 'Aug' '08',
      'Sep' '09', 'Oct' '10', 'Nov' '11', 'Dec' '12'}
  m =: s =~ /(\d{1,2}) ([A-Z][a-z]{2}) (\d{4})/
  when m:
    d mo y =: m:rest
    dd =: (d.# == 1).if("0$d" d)
    =>: "$y-$(months.(mo))-$dd"

defn build-info(star release commit):
  base =: +{:star star}
  cond:
    release: base.assoc(:release release)
    commit:  base.assoc(:commit commit)
    else:    base
