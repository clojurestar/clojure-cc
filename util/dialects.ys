#!/usr/bin/env ys-0

# Create the dialects page from YAML data injected into a Markdown file.
#
# Stars and latest-release info live in repo-data.yaml (gitignored, refreshed
# by `make repo-data`). When the file is absent, those cells render empty.

defn main():
  rows =: read('src/dialects.yaml'):yaml/load
  data-file =: 'repo-data.yaml'
  repo-data =:
    if data-file:fs-e:
      then: data-file:read:yaml/load
      else: +{}
  template =: read('src/dialects.md')
  table =: render-table(rows repo-data)
  print: template.replace('+++DIALECTS+++' table)

defn render-table(rows repo-data): |-
  |   | ★ | Tags | Dialect | Host | Release | Description |
  |--:|------:|------|---------|------|---------|-------------|
  $(map-indexed(fn([i r] render-row(r repo-data (inc i))) rows):text:trimr)

defn render-row(row repo-data num):
  url =: row.site ||| row.repo
  slug =: lc(row.name).replace(/[^a-z0-9]+/ '-')
  info =: repo-data.(row.repo).or(+{})
  star-cell =: render-star(info.star row.repo)
  rel-cell =: render-release(info.release info.commit)
  num-cell =: "**[$num](#$slug){ #$slug }**"
  =>: "| $num-cell | $star-cell | $(render-badges(row.tags))| \
        [$(row.name)]($url) | $(row.host) | $rel-cell | $(row.desc) |"

defn render-star(star repo):
  if star:
    then: "[$star]($repo)"
    else: ''

defn render-release(release commit):
  cond:
    release: "**[$(release.date) $(release.version)]($(release.url))**"
    commit:  "*[$(commit.date) $(commit.sha)]($(commit.url))*"
    else:    ''

defn render-badges(tags):
  when tags:
    inner =: tags.map(tag-badge):join
    =>: "<span class=\"badges\">$inner</span>"

defn tag-badge(tag):
  cond:
    (tag == 'clojure'): ":simple-clojure:{ .badge .badge-clojure \
      title=\"Faithful Clojure implementation\" } "
    (tag == 'lisp'): ":material-code-parentheses:{ .badge .badge-lisp \
      title=\"Clojure-inspired Lisp\" } "
    (tag == 'native'): ":material-lightning-bolt:{ .badge .badge-native \
      title=\"Compiles your code to a native binary\" } "
    (tag == 'repl'): "[:material-console-line:](try.md \
      \"Instant REPL support\"){ .badge .badge-repl } "
    (tag == 'nrepl'): ":material-lan-connect:{ .badge .badge-nrepl \
      title=\"Built-in nREPL support\" } "
