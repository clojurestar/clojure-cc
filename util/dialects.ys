#!/usr/bin/env ys-0

# Create the dialects page from YAML data injected into a Markdown file.

defn main():
  data =: read('src/dialects.yaml'):yaml/load
  template =: read('src/dialects.md')
  print: data.reduce(replace-group template)

defn replace-group(text group):
  placeholder =: "+++$(group-key(group.name))+++"
  table =: group.list:render-table
  replace text: placeholder table

defn group-key(name):
  uc(name)
    .replace(' ' '-')
    .replace(/[^A-Z0-9-]/)

defn render-table(rows): |-
  | Dialect | Host | Description |
  |---------|------|-------------|
  $(rows.map(render-row):text:trimr)

defn render-row(row):
  name site =: row.name row.site
  link =: "[$name]($site)$(render-badges(row.tags))"
  =>: "$link | $(row.host) | $(row.desc)"

defn render-badges(tags):
  when tags:
    apply(str tags.map(tag-badge))

defn tag-badge(tag):
  cond:
    (tag == 'repl'):     ' [:material-console-line:](/cli "Instant REPL support"){ .badge .badge-repl }'
    (tag == 'native'):   ' :material-lightning-bolt:{ .badge .badge-native title="Compiles your code to a native binary" }'
    (tag == 'faithful'): ' :simple-clojure:{ .badge .badge-faithful title="Faithful Clojure implementation" }'
    (tag == 'inspired'): ' :material-code-parentheses:{ .badge .badge-inspired title="Clojure-inspired Lisp" }'
