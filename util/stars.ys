#!/usr/bin/env ys-0

# Refresh star counts in src/dialects.yaml.
#
# For each dialect with a `repo:` URL on GitHub or GitLab, queries
# the host's API and rewrites the entry's `star:` line in place.
# Entries without a recognized repo URL keep their existing value.

defn main():
  path =: 'src/dialects.yaml'
  text =: path:read
  data =: text:yaml/load
  entries =: data.mapcat(\(_.list))
  stars =: entries.mapv(new-star)
  write: path rewrite(text stars)
  say: "Refreshed $(entries:count) entries."

defn new-star(entry):
  url =: entry.repo
  n =:
    when url:
      fetch-stars: url
  if n:
    then:
      warn: "  $(entry.name) ($url): $n"
      =>: n
    else:
      warn: "  $(entry.name): skipped"
      =>: entry.star

defn fetch-stars(url):
  cond:
    url =~ /github\.com\//: github-stars(url)
    url =~ /gitlab\.com\//: gitlab-stars(url)

defn github-stars(url):
  m =: re-find(/github\.com\/([^\/?#]+)\/([^\/?#]+)/ url)
  api =: "https://api.github.com/repos/$(m.1)/$(m.2)"
  json =: http/get(api).body:json/load
  =>: json.stargazers_count

defn gitlab-stars(url):
  m =: re-find(/gitlab\.com\/([^\/?#]+)\/([^\/?#]+)/ url)
  api =: "https://gitlab.com/api/v4/projects/$(m.1)%2F$(m.2)"
  json =: http/get(api).body:json/load
  =>: json.star_count

defn rewrite(text stars):
  fragments =: text.split(/[ ]{4}star:\ \d+/)
  new-lines =: stars.mapv(star-line)
  =>: interleave(fragments new-lines):join + fragments.$

defn star-line(n): "    star: $n"
